/**
 * Verify LCR interaction classification and the non-hardcoded response contract.
 * Wording is generated by the authenticated Qwen-backed LCR endpoint; these
 * tests deliberately do not assert fixed caregiver-facing sentences.
 */
import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import {
  isCasualGreetingInput,
  isHowAreYouInput,
  isGratitudeInput,
  isInsultOrFrustrationInput,
  isChangeOrientedInput,
} from "../src/lib/greeting-orientation";

assert.equal(isCasualGreetingInput("Hi"), true);
assert.equal(isCasualGreetingInput("Good morning!"), true);
assert.equal(isCasualGreetingInput("Good morning, SolenOS!"), true);
assert.equal(isCasualGreetingInput("Hey there!"), true);
assert.equal(isCasualGreetingInput("Hello, SolenOS."), true);
assert.equal(isHowAreYouInput("How are you?"), true);
assert.equal(isGratitudeInput("Thank you so much"), true);
assert.equal(isInsultOrFrustrationInput("idiot"), true, "clear insult input must be classified as frustration");
assert.equal(isInsultOrFrustrationInput("you suck"), true, "direct insult input must be classified as frustration");
assert.equal(isInsultOrFrustrationInput("Mom fell last night"), false);
assert.equal(isChangeOrientedInput("Mom has been more confused lately"), true);

const implementation = readFileSync(
  new URL("../src/lib/greeting-orientation/orientation.ts", import.meta.url),
  "utf8",
);
assert.match(implementation, /api\/lcr\/orientation/);
assert.doesNotMatch(implementation, /Your previous updates are still here/);
assert.doesNotMatch(implementation, /Ready to organize care information/);
const companion = readFileSync(
  new URL("../src/components/workflows/AICompanion.tsx", import.meta.url),
  "utf8",
);
assert.ok(companion.includes("postJSON('/api/lcr/orientation'"), "Companion must route greetings through the LCR orientation endpoint");
assert.ok(companion.includes("postJSON('/conversation/message'"), "Companion must route care questions through the conversation endpoint");
assert.match(companion, /postJSON\('\/conversation\/message'/);
const apiClient = readFileSync(
  new URL("../src/api/client.ts", import.meta.url),
  "utf8",
);
assert.match(
  apiClient,
  /pathname\.endsWith\("\/lcr\/orientation"\) && method === "POST"\) return 210_000;/,
  "LCR orientation must not time out before the backend's bounded 180-second Qwen request",
);

console.log("Greeting orientation classification and non-hardcoded generation contract passed.");
