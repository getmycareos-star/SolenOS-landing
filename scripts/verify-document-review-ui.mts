import { readFileSync } from "node:fs";
import { strict as assert } from "node:assert";

const source = readFileSync("src/app/workspace/documents/page.tsx", "utf8");
assert(source.includes("postJSON(") && source.includes("/candidates/review"), "caregiver review must call the persisted backend decision endpoint");
assert(source.includes("/reviews"), "document review history must be restored from the backend");
assert(source.includes("/documents/analyses/"), "the saved extraction must be retrieved from the backend");
assert(source.includes("candidate.source_quote"), "every candidate must display its source quotation");
assert(source.includes("source_span_start"), "candidate source offsets must be part of the client contract");
assert(source.includes("Correct and add to LCR"), "caregivers must be able to correct candidate text before accepting it");
assert(source.includes("Append correction to LCR"), "caregivers must be able to correct an already accepted report without erasing its history");
assert(source.includes("superseded_assertion_id"), "correction lineage must be displayed");
assert(source.includes("Needs clarification"), "caregivers must be able to defer uncertain candidates");
assert(source.includes("Review history"), "append-only review versions must be visible");
assert(source.includes("OCR confidence measures text recognition only, not clinical certainty"), "OCR confidence must not be presented as clinical certainty");
assert(source.includes("Scanned statements remain source evidence, not verified LCR facts"), "document text must not silently become an LCR fact");
assert(source.includes("reported LCR entry"), "accepted information must be described as a report rather than clinical verification");
assert(source.includes("Client-submitted text (unverified)"), "browser-submitted text must remain explicitly unverified");
console.log("✓ persisted extraction, source quotes, caregiver decisions and review history are wired");
console.log("✓ OCR confidence and LCR epistemic boundaries remain explicit");
