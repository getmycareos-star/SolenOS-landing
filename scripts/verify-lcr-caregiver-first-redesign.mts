import assert from "node:assert/strict";
import fs from "node:fs";

const workspacePage = fs.readFileSync("src/app/workspace/page.tsx", "utf8");
const capture = fs.readFileSync("src/components/mvp-workspace/CognitiveWorkspace.tsx", "utf8");
const styles = fs.readFileSync("src/app/mobile-app.css", "utf8");
const workspaceLayout = fs.readFileSync("src/app/workspace/layout.tsx", "utf8");
const appShell = fs.readFileSync("src/components/app-shell/AppShell.tsx", "utf8");
const documentPage = fs.readFileSync("src/app/workspace/documents/page.tsx", "utf8");
const timelinePage = fs.readFileSync("src/app/workspace/timeline/page.tsx", "utf8");

assert.match(workspacePage, /SOLENOS · LIVING CARE RECORD/, "workspace is visibly branded as the LCR");
assert.match(workspacePage, /CURRENT CARE REALITY/, "the default LCR view is explicitly current-care-first");
assert.match(workspacePage, /What matters now/, "the primary question is plain-language and present-focused");
assert.match(workspacePage, /getJSON\("\/care-continuity\/current-care\?limit_per_source=10"\)/, "the LCR reads its derived current-care projection from the authenticated backend API");
assert.match(workspacePage, /missing_required_sources/, "the UI can identify missing required sources");
assert.match(workspacePage, /source_coverage/, "the frontend validates the actual current-care projection response contract");
assert.match(workspacePage, /"items" in result/, "the frontend requires persisted projection items before rendering");
assert.match(workspacePage, /history_coverage/, "the UI communicates bounded history coverage");
assert.match(workspacePage, /Longitudinal Care History/, "history is a separate view of the same care record");
assert.match(workspacePage, /\/workspace\/timeline/, "history navigation uses the existing timeline route");
assert.match(workspacePage, /Source and record details/, "provenance is progressively disclosed rather than always expanded");
assert.match(workspacePage, /Try again/, "failed reads have a recoverable retry action");
assert.equal(workspacePage.includes("Record timeline"), false, "the LCR home does not render a duplicate timeline");
assert.equal(workspacePage.includes("Add to record"), false, "the LCR home does not own a duplicate capture composer");
assert.doesNotMatch(workspacePage, /solenos_workspace_consent|ResearchPreviewAckGate|ConsentGatePanel/, "LCR access is not gated by privacy/early-version checkboxes");
assert.match(workspaceLayout, /showFab={false}/, "workspace disables the global duplicate capture menu");
assert.doesNotMatch(workspaceLayout, /CareContextBar|careContext=/, "the workspace shell does not render a competing situation summary above the authoritative projection");
assert.match(appShell, /showFab && <div className="mobile-fab">/, "the shared shell can suppress the capture menu on record-first routes");
assert.doesNotMatch(capture, /ConsentGatePanel|consentState !== "accepted"|ResearchPreviewAckGate/, "specialized capture is not blocked by acknowledgement checkboxes");
assert.doesNotMatch(workspaceLayout, /type="checkbox"|ResearchPreviewAckGate|ConsentGatePanel/, "workspace route mounts without a pre-entry checkbox");
assert.match(documentPage, /postFormData\("\/upload"/, "document upload stays in Document AI and uses the backend upload contract");
assert.match(documentPage, /getBlob\("\/upload\//, "Document AI can retrieve the original stored file");
assert.ok(timelinePage.includes("care-continuity/context"), "Longitudinal Care History reads the shared scoped LCR context");
assert.ok(!timelinePage.includes("compose"), "history does not reopen the duplicate LCR capture composer");
assert.ok(timelinePage.includes("source_label"), "history preserves source attribution when available");
assert.ok(timelinePage.includes("epistemic_status"), "history preserves uncertainty/status metadata");
assert.ok(timelinePage.includes("record-revisions?limit=100"), "history retrieves persisted corrections and revisions");
assert.ok(timelinePage.includes("record-versions?limit=100"), "history retrieves persisted record versions");
assert.ok(timelinePage.includes("Open Daily Care"), "history directs capture to the specialized Daily Care module");
assert.match(styles, /\.lcr-home/, "LCR layout styles are present");
assert.match(styles, /@media \(max-width: 540px\)/, "mobile layout is explicitly handled");

console.log("✓ LCR home reads the session-scoped current-care projection and surfaces incomplete coverage");
console.log("✓ Current Care Reality and Longitudinal Care History are distinct views");
console.log("✓ LCR home has no duplicate capture/document-ingestion controls or checkbox gate");
console.log("✓ Source details are progressive; failed reads have retry recovery");
console.log("✓ Document AI owns upload/download; history reads scoped LCR sources and version/revision records");
console.log("✓ Responsive LCR layout rules are present");
