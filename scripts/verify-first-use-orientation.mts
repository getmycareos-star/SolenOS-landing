import assert from "node:assert/strict";
import fs from "node:fs";
import path from "node:path";

const root = process.cwd();
const read = (file: string) => fs.readFileSync(path.join(root, file), "utf8");
const workspace = read("src/app/workspace/page.tsx");
const orientation = read("src/components/onboarding/FirstUseOrientation.tsx");
const context = read("src/lib/workspace-context.tsx");
const shell = read("src/components/app-shell/WorkspaceShellContent.tsx");
const consentForm = read("src/components/public/EarlyAccessConsentForm.tsx");
const feedback = read("src/components/mvp-workspace/HelpImproveSolenos.tsx");
const settings = read("src/app/workspace/settings/page.tsx");
const styles = read("src/app/mobile-app.css");
const productDirective = read("docs/02-product/solenos-first-time-caregiver.md");

assert.match(workspace, /<FirstUseOrientation\\s*\\/>/, "Today must own the shared first-use experience");
assert.match(orientation, /Early access · We&apos;re testing SolenOS/, "First use must disclose early testing");
assert.match(orientation, /Who is this care record for\\?/, "First use must explain recipient identity");
assert.match(orientation, /Their name <span>\\(optional\\)<\\/span>/);
assert.match(orientation, /Your relationship <span>\\(optional\\)<\\/span>/);
assert.match(orientation, /Add a care update/);
assert.match(orientation, /Upload a document/);
assert.match(orientation, /Ask SolenOS a question/);
assert.match(orientation, /AI suggestions are not confirmed medical facts/);
assert.match(orientation, /Continue to Today/);
assert.match(orientation, /\\/workspace\\/daily-care/);
assert.match(orientation, /\\/workspace\\/documents/);
assert.match(orientation, /\\/workspace\\/companion/);
assert.match(orientation, /first_use_orientation_completed_at/);
assert.match(orientation, /completion\\.completed !== true/);
assert.match(orientation, /completion\\.completed_at/);
assert.doesNotMatch(orientation, /localStorage/);
assert.doesNotMatch(orientation, /hasSavedCareContext/);
assert.match(orientation, /if \\(hasCareHistory && !saved\\.first_use_orientation_completed_at\\)/);
assert.match(orientation, /Reconnect to check your saved care history/);
assert.match(orientation, /Welcome back/);
assert.match(context, /hasCareHistory/);
assert.doesNotMatch(context, /hasCompletedOnboarding|onboardingPending/);

assert.match(shell, /getJSON\\([\\s\\S]*?\\/consent\\?person_id=/);
assert.match(shell, /status\\.verified === true && status\\.required === false/);
assert.match(shell, /status\\.required === true/);
assert.match(shell, /EarlyAccessConsentForm/);
assert.match(shell, /continueHref=""|continueHref=\{""\}/);
assert.match(consentForm, /medical or emergency advice/);
assert.match(consentForm, /care information is not sold or used for advertising/);
assert.match(consentForm, /people I trust/);
assert.match(consentForm, /data_improvement_consent: false/);
assert.match(feedback, /data_improvement_consent/);
assert.match(feedback, /feedback_category: option/);
assert.match(settings, /<HelpImproveSolenos compact \/>/);
assert.match(styles, /\\.first-use-orientation/);
assert.match(styles, /\\.early-access-compact/);
assert.match(styles, /\\.workspace-consent-gate/);
assert.match(productDirective, /same route, page structure, navigation/);
assert.match(productDirective, /consent/i);
assert.doesNotMatch(productDirective, /Do not use a blanket checkbox or consent overlay to block entry/);

console.log("✓ shared first-use orientation, persisted caregiver completion, workspace-wide required consent, early-access feedback and returning state contracts are present");
