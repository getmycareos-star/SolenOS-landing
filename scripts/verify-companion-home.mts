import assert from "node:assert/strict";
import fs from "node:fs";
import path from "node:path";

const root = process.cwd();
const read = (file: string) => fs.readFileSync(path.join(root, file), "utf8");
const home = read("src/app/workspace/page.tsx");
const dailyCare = read("src/app/workspace/daily-care/page.tsx");
const shell = read("src/components/app-shell/AppShell.tsx");
const record = read("src/app/workspace/record/page.tsx");
const companionAlias = read("src/app/workspace/companion/page.tsx");

assert.match(home, /@\/components\/workflows\/AICompanion/);
assert.match(home, /solenos-companion-home/);
assert.match(home, /companion-conversation/);
assert.match(home, /conversation|Companion/);
assert.match(home, /<Companion home \/>/);
const companion = read("src/components/workflows/AICompanion.tsx");
const documents = read("src/app/workspace/documents/page.tsx");
assert.match(companion, /companion-shell.*is-home/);
assert.doesNotMatch(companion, /Add to care story/);
assert.match(companion, /Upload document/);
assert.match(companion, /Snap a photo/);
assert.match(companion, /Scan document/);
assert.match(documents, /params.get\("upload"\)/);
assert.match(documents, /params.get\("capture"\)/);
assert.match(documents, /params.get\("scan"\)/);
assert.match(documents, /setRequestedIntake\(action\)/);
assert.match(documents, /Choose document/);
assert.match(documents, /Open camera/);
assert.match(documents, /Capture document/);
assert.match(documents, /capture="environment"/);
assert.match(documents, /prepareImagePage/);
assert.match(documents, /Review scan and extracted text/);
assert.match(home, /compose/);
assert.match(dailyCare, /StructuredDailyCapture/);
assert.doesNotMatch(dailyCare, /DailyCareQwen|daily-care\/intelligence\/ask|Ask Daily Care Qwen/);
assert.match(shell, /href: "\/workspace", label: "AI Companion"/);
assert.doesNotMatch(shell, /href: "\/workspace\/record"/);
assert.match(shell, /MoreVertical/);
assert.match(shell, /solenos-main-menu/);
assert.match(shell, /aria-label="More options"/);
assert.match(shell, /Daily Care/);
assert.match(shell, /Documents/);
assert.match(shell, /Care Handoffs/);
assert.match(shell, /Appointments/);
assert.match(record, /redirect\("\/workspace"\)/);
assert.doesNotMatch(record, /LCRCurrentUnderstanding|Record timeline|CognitiveWorkspace/);
assert.doesNotMatch(record, /lcr-support-section|AI Companion/);
assert.match(companionAlias, /redirect\("\/workspace"\)/);

console.log("Companion home contract passed: AI Companion home, three document-intake actions, persistent main options menu, no LCR sidebar destination, and the legacy LCR route redirected away from the main experience, with no AI agent embedded in Daily Care.");
