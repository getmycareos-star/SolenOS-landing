assert.match(shell, /To add SolenOS to your home screen/);
assert.match(shell, /iPhone or iPad/);
assert.match(moreMenu, /aria-label="More care record actions"/);
assert.match(shell, /finally \{\s*setInstallPrompt\(null\)/);
