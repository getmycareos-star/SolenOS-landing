import assert from "node:assert/strict";
import { readFileSync } from "node:fs";

const home = readFileSync("src/app/workspace/page.tsx", "utf8");
const component = readFileSync("src/components/app-shell/UpcomingAppointmentSummary.tsx", "utf8");
const styles = readFileSync("src/app/workspace/experience-design-system-v2.css", "utf8");

assert.ok(home.includes("UpcomingAppointmentSummary"), "caregiver home must surface recorded appointments");
assert.ok(component.includes('getJSON("/appointment-workspaces/preparation-brief?window_days=90")'), "use the existing appointment preparation contract");
assert.ok(component.includes("await ensureAnonymousSession()"), "appointment information must use the current authenticated/anonymous session");
assert.ok(component.includes("result.person_scope_verified !== true"), "appointment summary must reject a response without verified active-person scope");
assert.ok(component.includes("result.read_only !== true"), "appointment summary must require the read-only preparation contract");
assert.ok(component.includes('window.addEventListener("personIdChanged", refreshAfterPersonChange)'), "appointments must refresh when the active care recipient changes");
assert.ok(component.includes("setBrief(null);"), "appointments from the previous care recipient must be cleared before a scope switch");
assert.ok(component.includes('window.addEventListener("careRecordUpdated", refreshAfterRecordWrite)'), "appointments must refresh after care-record writes");
assert.ok(component.includes("requestId !== requestVersion.current"), "late appointment responses must not overwrite the active care recipient's data");
assert.ok(component.includes("No appointment information was returned from the available sources. This does not prove that no appointment exists."), "empty results must not be represented as proof that no appointment exists");
assert.ok(component.includes("Appointment information is unavailable"), "retrieval failures must remain visible");
assert.ok(component.includes("appointmentHasTime"), "date-only appointments must not be assigned an invented time-sensitive urgency");
assert.ok(component.includes("appointmentTime - Date.now() <= 24 * 60 * 60 * 1000"), "appointments due within 24 hours must be identified as time-sensitive");
assert.ok(component.includes("is-time-sensitive"), "time-sensitive appointments must receive a distinct presentation");
assert.ok(styles.includes(".solenos-upcoming-appointment__item.is-time-sensitive"), "time-sensitive appointment styling must be present");
assert.ok(component.includes("onAction={() => void load()}"), "failed retrieval must be recoverable");
assert.ok(component.includes("SolenOS has not booked or confirmed it with a provider."), "recorded appointments must not be represented as external bookings");
assert.ok(component.includes('href="/workspace/appointments"'), "caregivers must be able to open the existing appointment workflow");
assert.ok(component.includes("Prepare for this visit"), "a saved upcoming appointment must offer a contextual preparation action");
assert.ok(component.includes("Review appointment details"), "unknown or overdue appointment timing must offer review rather than false preparation certainty");
assert.ok(component.includes("appointment_related_open_loops"), "Home must read persisted appointment-related follow-ups from the existing preparation contract");
assert.ok(component.includes("appointment_needs"), "Home must surface unresolved appointment questions from the care record");
assert.ok(component.includes("Appointment follow-ups"), "appointment-related open loops and questions must be visible even without a booked appointment");
assert.ok(component.includes('href="/workspace/open-loops"'), "caregivers must have a direct route to review recorded follow-ups");
assert.ok(component.includes("lcr_retrieval_status"), "the summary must inspect source retrieval completeness");
assert.ok(component.includes("appointmentContextIncomplete"), "partial or failed source retrieval must qualify the appointment summary");
assert.ok(component.includes("Some care-record sources could not be checked"), "partial retrieval must be explained rather than presented as complete");
assert.ok(component.includes("A follow-up is recorded, but no appointment date or booking is confirmed."), "an appointment-related question must not be presented as a booked appointment");
assert.ok(styles.includes(".solenos-upcoming-appointment__follow-ups"), "appointment follow-ups must have a distinct readable presentation");
assert.ok(styles.includes(".solenos-upcoming-appointment__notice"), "partial retrieval warnings must have a visible presentation");
assert.ok(styles.includes(".solenos-upcoming-appointment__prepare"), "the appointment preparation action must have an accessible presentation");
assert.ok(styles.includes("min-height: 44px"), "appointment actions must meet the minimum touch-target height");
assert.ok(styles.includes(".solenos-upcoming-appointment"), "the summary must use responsive shared workspace styling");
assert.ok(styles.includes("@media (max-width: 520px)"), "the appointment summary must adapt to mobile widths");

console.log("PASS: caregiver home appointment summary uses persisted appointment data, explicit unavailable states and existing appointment navigation");
