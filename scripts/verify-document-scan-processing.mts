import { readFileSync } from "node:fs";
import { strict as assert } from "node:assert";

const source = readFileSync("src/app/workspace/documents/page.tsx", "utf8");
const dailyCare = readFileSync("src/app/workspace/daily-care/page.tsx", "utf8");
const review = readFileSync("src/components/DocumentIntelligenceReview.tsx", "utf8");
assert.match(review, /This only tells us how clearly SolenOS could read the words\. It does not tell us whether the words or suggested care details are correct/);
assert(!source.includes("extractText("), "the Documents screen must not upload a file for separate preflight extraction");
assert(!source.includes("review and correct its extracted text first"), "caregivers must not be asked to manually review client-only OCR before saving");
assert(!source.includes("page.reviewed") && !source.includes("page.text"), "the upload draft must not carry discarded client-side text or review flags");
assert(!source.includes('apiUrl("/api/extract")'), "the Documents screen must not send the same original through a preflight extractor before saving");
assert(!source.includes('Extracted text — review and correct before saving'), "caregivers must not correct client-side text that the upload API does not persist");
assert.match(source, /SolenOS will read it and prepare details for you to check after upload/, "the caregiver must be told that server extraction starts after the original is saved");
assert.match(source, /form\.append\("file", page\.file\)/, "the original uploaded bytes must be retained");
assert.equal((source.match(/Array\.from\(event\.currentTarget\.files \|\| \[\]\)/g) || []).length, 2, "both upload and camera inputs must copy FileList entries before clearing the input");
assert.match(source, /scan_crop_json: JSON\.stringify\(page\.crop\)/, "crop metadata must accompany the original");
assert.match(source, /for \(const \[key, value\] of Object\.entries\(fields\)\) form\.append\(key, value\)/, "per-page metadata must accompany the original upload");
assert(!source.includes("Extracting readable text"), "the upload screen must not claim pre-upload OCR is running");
assert(!source.includes('aria-label="Review extracted text before saving"'), "the intake list must not be labeled as an OCR review step");
assert.match(source, /if \(!reviewPages\.length\)/, "saving must not require caregivers to review every page first");
assert.match(source, /scan_review_status: "not_reviewed"/, "the upload must not claim the caregiver reviewed text that has not yet been extracted by the server");
assert.match(source, /Save files<\/button>/, "caregivers must be able to save originals before reviewing extracted text");
assert.match(source, /data-scan-crop-stage/, "scan editor must render a crop stage");
assert(!source.includes("createProcessedImage("), "the browser must not transform the original image bytes before upload");
assert(!source.includes("createMultiPagePdf(") && !source.includes("Combine scan pages into one PDF"), "multiple scan pages must remain separate original files rather than being recomposed in the browser");
assert.match(source, /scan_rotation_degrees: String\(page\.rotation\)/, "per-page rotation must accompany the immutable original for server-side processing");
assert.match(source, /scan_crop_json: JSON\.stringify\(page\.crop\)/, "per-page crop metadata must accompany the immutable original for server-side processing");
assert.match(source, /scan_text_prepared: "false"/, "the upload must not claim that browser OCR prepared the source");
assert.match(source, /stored\.processing_status === "completed"[\s\S]*?backgroundProcessingCompleted \+= 1/, "completed document processing must be tracked separately from queued work");
assert.match(source, /backgroundProcessingCompleted > 0[\s\S]*?has finished reading[\s\S]*?ready for you to review/, "the caregiver must not be told completed reading is still running");

assert.match(source, /Move crop area/, "crop rectangle must be movable by pointer and keyboard");

const attachmentSource = readFileSync("src/components/mvp-workspace/capture/extract-attached.ts", "utf8");
const attachmentTypes = readFileSync("src/lib/mvp-workspace/types.ts", "utf8");
const addRecordSource = readFileSync("src/components/mvp-workspace/AddSituationPanel.tsx", "utf8");
const workspaceSource = readFileSync("src/components/mvp-workspace/CognitiveWorkspace.tsx", "utf8");
const intelligenceReviewSource = readFileSync("src/components/DocumentIntelligenceReview.tsx", "utf8");
assert.match(attachmentTypes, /status: "pending" \| "saved" \| "ready" \| "failed"/, "saved evidence must not be represented as completed interpretation");
assert.match(attachmentSource, /entryMethod === "snap"[\s\S]*?status: "saved"/, "Snap must be marked saved, not document-ready");
const captureFunction = attachmentSource.slice(attachmentSource.indexOf("export async function extractAttachedDocument"), attachmentSource.indexOf("export async function retryAttachedDocument"));
assert(!captureFunction.includes("/extract"), "caregiver capture must not wait for synchronous document OCR");
assert(!captureFunction.includes("/intelligence"), "caregiver capture must not wait for synchronous Qwen interpretation");
assert.match(attachmentSource, /durably queues document extraction and understanding/, "the upload contract must hand off processing to the durable worker");
assert.match(addRecordSource, /Saved — SolenOS is reading it in the background/, "saved documents must show truthful background-processing state");
assert.match(addRecordSource, /Original saved — waiting for SolenOS to read it/, "a saved original must not be described as processing when the queue failed");
assert.match(addRecordSource, /doc\.status === "saved" && !!doc\.errorNote/, "a saved original with a queue failure must offer a processing-only retry");

assert.match(attachmentSource, /document\.entryMethod === "snap" && document\.evidenceId[\s\S]*?status: "saved"/, "retry must not send a saved care photo through document OCR");
assert.match(addRecordSource, /Photo saved — not read yet/, "caregivers must see that a Snap photo is saved but not interpreted");
assert.match(addRecordSource, /Saved — SolenOS is reading it in the background/, "caregivers must see that saved documents are processing without blocking capture");
assert.match(addRecordSource, /d\.status === "saved" && d\.evidenceId/, "saved document evidence must be eligible for care-entry submission");
assert.match(workspaceSource, /SolenOS is reading it in the background/, "the care entry must not claim document interpretation completed");
assert.match(workspaceSource, /d\.status === "saved" && d\.evidenceId/, "saved evidence must remain eligible for care-entry submission");
assert.match(workspaceSource, /evidence_id: d\.evidenceId/, "care-entry submission must reference the persisted evidence ID");
assert.match(intelligenceReviewSource, /analysis.extraction_status === "partial"/, "incomplete documents must remain visibly partial");
assert.match(intelligenceReviewSource, /SolenOS is trying to read those pages again/, "transient page failures must be retried automatically");
assert.match(intelligenceReviewSource, /retry_exhausted_page_numbers/, "exhausted page retries must remain visible and distinct from unreadable pages");
assert.match(intelligenceReviewSource, /SolenOS is reading this document in the background\. You do not need to stay on this screen\./, "caregivers must not supervise background processing");
assert.match(intelligenceReviewSource, /processing_jobs\?/, "the review panel must read durable background job state");
assert.match(intelligenceReviewSource, /!processingJobs\.some\(\(job\) => job\.evidence_id === analysis\.source_evidence_id/, "background processing status must be scoped to the document's persisted job");
assert.match(intelligenceReviewSource, /job\?\.status === "failed" \? "SolenOS could not finish reading this document\. The original file is still saved\."/,
  "a failed or completed-without-analysis job must not be shown as still waiting");
assert.match(intelligenceReviewSource, /job\?\.status === "failed" \? "Try reading again" : "Read document"/,
  "a saved original whose processing did not finish must offer a processing-only retry");
assert.match(intelligenceReviewSource, /window\.setTimeout\(\(\) => \{ void load\(\); \}, 3000\)/, "document review status must refresh while background processing is active");
assert.match(intelligenceReviewSource, /postJSON\("\/documents\/" \+ encodeURIComponent\(evidenceId\) \+ "\/queue"/, "initial upload handoff must use the durable server processing queue");
assert(!intelligenceReviewSource.includes('postJSON("/documents/" + encodeURIComponent(document.id) + "/extract"'), "the review screen must not perform blocking extraction");
assert.doesNotMatch(intelligenceReviewSource, /Retry background processing|Continue reading/, "caregivers must not be asked to supervise or manually resume document processing");
assert.match(intelligenceReviewSource, /analysis\.extraction_status === "partial"/, "partial source extraction must be distinct from Qwen processing status");
assert.match(intelligenceReviewSource, /analysis\.ocr_quality_by_page/, "per-page OCR confidence must be exposed");
assert.match(intelligenceReviewSource, /SolenOS may misread names, dates and numbers, especially in handwriting/, "caregivers must be warned that names, dates and numbers can be misread");
assert.match(intelligenceReviewSource, /Compare each suggested detail with the original document before accepting it/, "handwriting uncertainty must remain visible");
assert.match(intelligenceReviewSource, /SolenOS may misread names, dates and numbers, especially in handwriting/, "OCR quality must not be presented as correctness probability");
assert.match(intelligenceReviewSource, /model_provenance/, "document processing model provenance must be available to the review view");

assert.match(source, /ingestionKey: string; captureTimestamp: string/, "scan uploads must carry stable retry and capture metadata");
assert.match(source, /ingestion_key: page\.ingestionKey/, "scan retry must reuse its original idempotency key");
const scanCaptureSource = readFileSync("src/components/mvp-workspace/capture/ScanDocumentCapture.tsx", "utf8");
const scanAttachmentSource = readFileSync("src/components/mvp-workspace/capture/extract-attached.ts", "utf8");
assert.match(scanCaptureSource, /Rotate 90°/, "each captured scan page must support rotation correction");
assert.match(scanCaptureSource, /cropInsetsPercent/, "each captured scan page must support crop adjustment");
assert.match(scanCaptureSource, /scanRotationDegrees: page\.rotationDegrees/, "scan adjustments must travel with each original page");
assert.match(scanAttachmentSource, /scan_rotation_degrees/, "scan rotation must be persisted as OCR metadata");
assert.match(scanAttachmentSource, /scan_crop_json/, "scan crop must be persisted as OCR metadata");
assert.match(scanAttachmentSource, /fields\.scan_review_status\s*=\s*"not_reviewed"/, "scan capture must remain explicitly unreviewed after crop adjustments");
assert.match(scanAttachmentSource, /fields\.scan_text_prepared\s*=\s*"false"/, "crop adjustments must not mark OCR text as caregiver-prepared");
assert.doesNotMatch(scanAttachmentSource, /fields\.scan_review_status\s*=\s*"(?:reviewed|approved|confirmed)"/, "crop adjustments must never attest caregiver review");
assert.match(scanAttachmentSource, /form\.append\("file", file\)/, "scan adjustments must never replace the original uploaded file bytes");
assert.match(addRecordSource, /rotationDegrees: \(file as ScanPageFile\)\.scanRotationDegrees/, "per-page scan adjustments must be passed through the care-entry capture flow");

const saveFunction = source.slice(source.indexOf("const saveReviewedPages"), source.indexOf("const openOriginal"));
assert.match(saveFunction, /document_processing_job_id/, "the save response must confirm durable background processing was queued");
assert(!saveFunction.includes("/extract"), "the caregiver page must not own document extraction after upload");
assert(!saveFunction.includes("/intelligence"), "the caregiver page must not own document understanding after upload");
assert.match(source, /Keep this page open until your files are saved\. After that, SolenOS will keep reading them even if you leave\./, "the caregiver must be told to wait only until the original and background job are saved");

assert.match(source, /capture_timestamp: page\.captureTimestamp/, "scan retry must preserve capture time");
assert.match(source, /deleteJSON\("\/upload\/" \+ encodeURIComponent\(selected\.id\)\)/, "document deletion must call the authenticated backend lifecycle endpoint");
assert.match(source, /The document and its unreviewed details were deleted/, "the caregiver must receive a success message only after backend deletion confirms");
assert.match(source, /Mark as corrected copy/, "caregivers must be able to explicitly link a corrected copy to its predecessor");
assert.match(source, /selected\.possibleVersionOfEvidenceId && !selected\.evidence\.parent_evidence_id/, "corrected-version clarification must appear only when a possible predecessor is detected");
assert.match(source, /version-comparison/, "the document view must retrieve source-grounded differences for corrected versions");
assert.match(source, /A healthcare professional has not confirmed these differences/, "version differences must not be presented as clinical truth");
assert.match(dailyCare, /\/documents\/status\?limit=10/, "Daily Care must retrieve persisted document processing status");
assert.match(dailyCare, /Recent documents/, "Daily Care must surface recent document activity");
assert.match(dailyCare, /You do not need to stay on this screen/, "background processing must not require the caregiver to supervise it");
assert.match(dailyCare, /could not be read/, "unreadable pages must be reported without treating missing text as empty content");
assert.match(dailyCare, /Follow-up added to your existing follow-ups/, "accepted document recommendations must be surfaced through the existing follow-up record");
assert.match(review, /Saved as a report — not confirmed by a healthcare professional/, "medication candidates must not be presented as verified medication changes");
assert.match(dailyCare, /Medicine information was saved as a report, but it has not been confirmed/, "Daily Care must distinguish an unconfirmed medication report from a verified care-record change");
assert.match(source, /let scanPageNumber = 0/, "scan page numbers must not be affected by other file types in the batch");

console.log("✓ crop and straighten are applied to pixels before OCR");
console.log("✓ caregiver can move crop area and adjust margins");
console.log("✓ multi-page PDF assembly preserves individual originals");
console.log("✓ original scan bytes and server-applied scan processing metadata are preserved");

assert(source.includes('facingMode: { ideal: cameraFacingMode }'), "the scanner must request the selected front or back camera when the device supports it");
assert(source.includes("Use front camera") && source.includes("Use back camera"), "caregivers must be able to switch cameras while scanning");
assert(source.includes("}, [cameraOpen, cameraFacingMode]);"), "switching cameras must stop the previous stream and acquire the newly selected camera");
