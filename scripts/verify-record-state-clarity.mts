import assert from "node:assert/strict";
import fs from "node:fs";
import path from "node:path";

const root = process.cwd();
const read = (file: string) => fs.readFileSync(path.join(root, file), "utf8");

const state = read("src/components/ui/RecordState.tsx");
const lcr = read("src/components/mvp-workspace/LCRCurrentUnderstanding.tsx");
const orientation = read("src/components/mvp-workspace/PersistedCareOrientation.tsx");
const overview = read("src/components/app-shell/CareRecordOverview.tsx");
const daily = read("src/app/workspace/daily-care/page.tsx");
const documents = read("src/app/workspace/documents/page.tsx");
const documentReview = read("src/components/DocumentIntelligenceReview.tsx");
const reminders = read("src/app/workspace/reminders/page.tsx");
const history = read("src/components/app-shell/HistoryDrawer.tsx");
const claimReview = read("src/components/ClaimAssessmentPanel.tsx");
const evidenceReview = read("src/components/EvidenceReviewPanel.tsx");
const appointmentWorkspace = read("src/components/workflows/AppointmentWorkspace.tsx");
const detailedAppointmentWorkspace = read("src/components/workflows/DetailedAppointmentWorkspace.tsx");
const companion = read("src/components/workflows/AICompanion.tsx");
const changeIntelligence = read("src/components/mvp-workspace/ChangeIntelligencePanel.tsx");

for (const kind of ["empty", "no-results", "loading", "error", "unavailable", "unconfirmed"]) {
  assert.ok(state.includes(`| "${kind}"`) || state.includes(`= "${kind}"`), `shared state supports ${kind}`);
}
assert.match(state, /aria-busy=\{isBusy \|\| undefined\}/);
assert.match(state, /role=\{isError \? "alert" : "status"\}/);

assert.match(lcr, /No care information recorded yet/);
assert.match(lcr, /href="\/workspace\/daily-care"/);
assert.doesNotMatch(lcr, /Missing information does not mean everything is fine/);
assert.doesNotMatch(lcr, /This does not mean there are no care needs|This is not a statement that no care needs exist/);
assert.match(lcr, /Not everything that happens is automatically recorded/);
assert.match(lcr, /error && projection &&/);
assert.match(lcr, /if \(manual\) setRefreshing\(true\);\s*else \{[\s\S]*?setProjection\(null\)/);
assert.doesNotMatch(lcr, /catch \(cause\) \{\s*setProjection\(null\)/);
assert.doesNotMatch(lcr, /Your Care Record does not have any care information yet/);
assert.doesNotMatch(lcr, /No saved care details to review yet/);
assert.doesNotMatch(lcr, /catch \(cause\) \{\s*setChanges\(\[\]\)/);
assert.doesNotMatch(lcr, /catch \(cause\) \{\s*setPatterns\(\[\]\)/);
assert.doesNotMatch(lcr, /catch \(cause\) \{\s*setAssessment\(null\)/);
assert.match(orientation, /Your care record is taking shape/);
assert.match(orientation, /href="\/workspace"/);
assert.match(orientation, /hasLoadedRef\.current = true/);
assert.doesNotMatch(orientation, /catch \{\s*setProjection\(null\)/);
assert.match(orientation, /error && <RecordState/);
assert.doesNotMatch(orientation, /Missing information does not mean that nothing happened/);

assert.match(daily, /contextLoading && !careItemsLoaded && <RecordState kind="loading"/);
assert.match(daily, /contextError && !careItemsLoaded \? \([\s\S]*?RecordState kind="error"/);
assert.match(daily, /if \(Array\.isArray\(payload\?\.items\)\) \{\s*setCareItems/);
assert.match(daily, /const \[careItemsLoaded, setCareItemsLoaded\] = useState\(false\)/);
assert.match(daily, /const \[historyLoaded, setHistoryLoaded\] = useState\(false\)/);
assert.match(daily, /const \[followUpsLoaded, setFollowUpsLoaded\] = useState\(false\)/);
assert.match(daily, /const \[documentsLoaded, setDocumentsLoaded\] = useState\(false\)/);
assert.match(daily, /contextError && careItemsLoaded/);
assert.match(daily, /historyError && !historyLoaded/);
assert.match(daily, /followUpsError && !followUpsLoaded/);
assert.match(daily, /documentsError && !documentsLoaded/);
assert.match(daily, /No outstanding items recorded\./);
assert.match(daily, /No documents added yet\./);
assert.match(daily, /historyError && <RecordState kind="error" title="Recent care history couldn’t be refreshed\."/);
assert.doesNotMatch(daily, /setCareItems\(Array\.isArray\(payload\?\.items\) \?/);
assert.match(daily, /historyError && !historyLoaded \? \([\s\S]*?RecordState kind="error"/);
assert.match(daily, /action=\{<button type="button" onClick=\{\(\) => setRefreshVersion/);
assert.doesNotMatch(daily, /This does not mean nothing happened|That does not mean nothing happened/);
assert.doesNotMatch(daily, /No new care records have been added since your last visit/);
assert.doesNotMatch(daily, /No updates have been saved today/);
assert.doesNotMatch(daily, /setHistoryItems\(\[\]\);\s*setHistoryMayBeTruncated\(false\);/);

assert.match(overview, /setHasLoaded\(true\)/);
assert.match(overview, /error && !hasLoaded && <RecordState kind="error"/);
assert.match(overview, /error && hasLoaded && <RecordState kind="error"/);
assert.match(overview, /No recent changes recorded\./);
assert.doesNotMatch(overview, /SolenOS will not invent a change when there is no record of one/);
assert.doesNotMatch(overview, /No care information is available in this view yet/);
assert.doesNotMatch(overview, /missing information as proof that nothing happened/);

assert.match(reminders, /const \[hasLoaded, setHasLoaded\] = useState\(false\)/);
assert.match(reminders, /!hasLoaded && error \? null/);
const followUps = read("src/app/workspace/open-loops/page.tsx");
assert.match(followUps, /if \(nextLoops\) setLoops\(nextLoops\)/);
assert.match(followUps, /if \(nextAssessment\) setAssessment\(nextAssessment\)/);
assert.match(followUps, /import \{ RecordState \} from "@\/components\/ui\/RecordState"/);
assert.doesNotMatch(followUps, /An empty section does not mean nothing needs attention/);
assert.doesNotMatch(followUps, /setLoops\(nextLoops \|\| \[\]\)/);
assert.match(reminders, /RecordState kind="loading"/);
assert.match(reminders, /hasLoaded \? <p>\{reminders\.length\}/);
assert.match(reminders, /void refresh\(\)\.catch\(\(\) => setError/);
assert.match(documents, /hasLoadedDocumentsRef\.current = true/);
assert.match(documents, /hasLoadedDocuments && documents\.length > 0 && \(/);
assert.match(documents, /listError && !hasLoadedDocuments \? null : visibleDocuments\.length === 0/);
assert.match(documents, /Saved documents couldn’t be refreshed/);
assert.match(documents, /RecordState/);
assert.match(documents, /kind=\{documents\.length === 0 \? "empty" : "no-results"\}/);
assert.doesNotMatch(documents, /SolenOS will not make up a history/);
assert.match(documentReview, /Saved document reviews couldn’t be loaded/);
assert.match(documentReview, /No document details are ready to review yet/);
assert.doesNotMatch(documentReview, /No documents are ready to review yet/);
assert.doesNotMatch(documentReview, /A missing history does not mean no earlier decision was made/);
assert.doesNotMatch(reminders, /SolenOS does not invent sample reminders/);

assert.doesNotMatch(history, /empty view is not evidence that no care was recorded|A missing detail does not mean something did not happen/);
assert.match(history, /error && records\.length > 0/);
assert.match(history, /error && !hasLoaded \? "Unavailable"/);
assert.match(history, /loading \? \([\s\S]*?Loading saved care history/);
assert.doesNotMatch(read("src/components/mvp-workspace/ChangeIntelligencePanel.tsx"), /This does not mean nothing changed/);
assert.doesNotMatch(read("src/app/workspace/open-loops/page.tsx"), /An empty section does not mean nothing needs attention/);
assert.doesNotMatch(claimReview, /This does not mean there are no past reviews|This does not mean this review is current/);
assert.match(appointmentWorkspace, /No appointment recorded in this summary/);
assert.doesNotMatch(appointmentWorkspace, /This does not mean none exist|This does not mean that no appointment exists|SolenOS will not invent what happened|This does not mean it is current/);
assert.doesNotMatch(detailedAppointmentWorkspace, /This does not mean there is no care history|This does not mean the information does not exist elsewhere|This does not mean it is current/);
assert.doesNotMatch(companion, /This does not mean information missing from the record is known/);
assert.match(companion, /The Care Assistant couldn’t respond/);
assert.match(companion, /requestError && messages\.length > 0/);
assert.match(companion, /setInput\(submittedText\)/);
assert.doesNotMatch(changeIntelligence, /That does not mean the event did not happen/);
assert.doesNotMatch(evidenceReview, /This does not mean there are no past reviews|This does not mean the record was empty|This does not mean they match|A missing historical revision is not proof/);
assert.doesNotMatch(evidenceReview, /setFreshnessAssessments\(\[\]\);\s*setFreshnessHistoryError/);
assert.doesNotMatch(evidenceReview, /setReviews\(\[\]\);\s*setHistoryUnavailable/);
assert.match(evidenceReview, /historyUnavailable && <p role="alert"/);
assert.match(claimReview, /Past reviews could not be loaded\. Try again\./);
assert.match(claimReview, /New information could not be checked\. Try again before relying on this review\./);

console.log("Record-state clarity and failure-separation checks passed.");
