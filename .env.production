# SolenOS production environment — committed (NEXT_PUBLIC_* vars are safe to expose).
# Netlify bakes this into the client bundle at build time.
# Frontend calls Railway backend directly to avoid Netlify proxy body-limitation
# for non-GET requests. CORS is configured in backend middleware.
NEXT_PUBLIC_API_URL=https://solenosbackend-production-8773.up.railway.app
