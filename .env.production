# Frontend environment variables for production
# Requests use the Netlify same-origin proxy to reach the Railway backend.
VITE_API_BASE=/api/v1
# Configure a real Sentry DSN in Netlify site environment variables if Sentry is enabled.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=solenos-frontend@0.1.0
