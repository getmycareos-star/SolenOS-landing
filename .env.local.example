# Copy to .env.local — NEVER commit .env.local
# Frontend uses NEXT_PUBLIC_* vars at build time.

NEXT_PUBLIC_API_URL=https://solenosbackend-production-8773.up.railway.app

# ─── Server-only ──────────────────────────────────────────────────────────────
# Gemini API key: server-side ONLY (read in src/app/api/analyze/route.ts)

GEMINI_API_KEY=
SOLENOS_GEMINI_MODEL=gemini-1.5-pro

# ─── Postgres (Ops Console + telemetry) ───────────────────────────────────────
DATABASE_URL=

# ─── SolenOS Ops Console (internal) ───────────────────────────────────────────
# https://solenosai.netlify.app/ops?key=<OPS_SECRET>
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
OPS_SECRET=

# ─── SolenOS Investor Metrics (aggregated only) ───────────────────────────────
# https://solenosai.netlify.app/metrics?key=<METRICS_SECRET>
METRICS_SECRET=

# ─── Voice Observation STT (OpenAI Whisper) ───────────────────────────────────
OPENAI_API_KEY=

# ─── TTS — Amazon Polly ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── TTS — Google Cloud Text-to-Speech ─────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=

# ─── OpenTelemetry Observability ───────────────────────────────────────────────
# Enable/disable OpenTelemetry (true/false)
OTEL_ENABLED=true
# Service name for telemetry
OTEL_SERVICE_NAME=solenos
# Service version
OTEL_SERVICE_VERSION=0.1.0
# Deployment environment
OTEL_ENVIRONMENT=development
# OTLP trace endpoint
OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTLP metrics endpoint
OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
# Trace sampling rate (0.0 to 1.0)
OTEL_TRACES_SAMPLE_RATE=1.0
